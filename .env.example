# Servidor Node.js (Express)
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL compartida (Docker local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vakera_db?schema=public"

# Clave secreta unificada para firma y verificación de JWT (HS256)
JWT_SECRET=vakera_super_secret_jwt_key_2026

# Servidor Python (Django)
DJANGO_SECRET_KEY=vakera-django-dev-secret-key-2026
DJANGO_DEBUG=True