{
  "rewrites": [
    {
      "source": "/api/py/(.*)",
      "destination": "https://vakera-python-api.onrender.com/api/py/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://vakera-node-api.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
