// Configuración de Prisma ORM para el Sistema Ganadero "Vakera"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS DE DOMINIO GANADERO Y CONTROL DE ACCESO (RBAC)
// ----------------------------------------------------

enum Rol {
  DUENO
  CAPATAZ
  PEON
  OFICINA
  VETERINARIO
}

enum EstadoSanitario {
  SALUDABLE
  OBSERVACION
  EN_TRATAMIENTO
}

enum EstadoParte {
  PENDIENTE
  APROBADO
  RECHAZADO
}

// ----------------------------------------------------
// MODELOS DE DATOS
// ----------------------------------------------------

// 1. Usuarios y Control de Acceso (RBAC)
model Usuario {
  id              String   @id @default(cuid())
  nombre          String
  email           String   @unique
  password        String   // Hash con bcrypt
  rol             Rol      @default(PEON)
  cargo           String?
  telefono        String?
  establecimientoId      String?   @default("est-el-rancho")
  establecimiento        String?   @default("El Rancho, Goya, Corrientes")
  fechaRegistro          DateTime  @default(now())
  emailVerificado        Boolean   @default(false)
  tokenVerificacion      String?
  tokenExpiracion        DateTime?
  tokenRecuperacion      String?
  expiracionRecuperacion DateTime?

  // Relaciones
  partesCreados     ParteDiario[]         @relation("PeonPartes")
  partesRevisados   ParteDiario[]         @relation("RevisorPartes")
  eventosACargo     SanidadEvento[]       @relation("ResponsableEventos")
  mensajesEnviados  MensajeChat[]         @relation("MensajesEnviados")
  mensajesRecibidos MensajeChat[]         @relation("MensajesRecibidos")
  contactosOcultos  ChatContactoOculto[]  @relation("ContactosOcultosUsuario")
  ocultadoPor       ChatContactoOculto[]  @relation("ContactosOcultosObjetivo")

  @@map("usuarios")
}

// 2. Potreros / Divisiones del Campo
model Potrero {
  id                String        @id @default(cuid())
  nombre            String
  descripcion       String?
  superficieHas     Float?
  capacidad         Int?
  establecimientoId String?       @default("est-el-rancho")
  establecimiento   String?       @default("El Rancho, Goya, Corrientes")
  
  // Relaciones
  animales      Ganado[]
  partes        ParteDiario[]

  @@index([establecimientoId])
  @@map("potreros")
}

// 3. Ganado y Rodeo
model Ganado {
  id                String          @id @default(cuid())
  caravana          String          @unique
  categoria         String          // Vacas, Toros, Novillos, Terneras, Vaquillonas
  raza              String
  sexo              String          // Hembra / Macho
  pesoKg            Float
  estadoSanitario   EstadoSanitario @default(SALUDABLE)
  fechaNacimiento   DateTime?
  fechaRegistro     DateTime        @default(now())
  establecimientoId String?         @default("est-el-rancho")
  establecimiento   String?         @default("El Rancho, Goya, Corrientes")

  // Relación con Potrero
  potreroId       String?
  potrero         Potrero?        @relation(fields: [potreroId], references: [id], onDelete: SetNull)

  // Historial sanitario individual opcional
  eventosSanitarios SanidadEvento[]

  @@index([establecimientoId])
  @@index([potreroId])
  @@index([estadoSanitario])
  @@map("ganado")
}

// 4. Módulo Sanitario y Calendario de Vacunación
model SanidadEvento {
  id                String   @id @default(cuid())
  evento            String   // e.g. "Vacunación Antiaftosa", "Control de Carbunclo"
  tipo              String   // "Vacunación", "Tratamiento", "Mantenimiento"
  lote              String?  // Nombre del lote / potrero o grupo
  fechaProgramada   DateTime
  estado            String   @default("Pendiente") // "Pendiente", "Próximo", "Completado", "Programado"
  prioridad         String   @default("Normal")    // "Alta", "Urgente", "Normal"
  icono             String?  @default("fa-syringe")
  notas             String?
  fechaRegistro     DateTime @default(now())
  establecimientoId String?  @default("est-el-rancho")
  establecimiento   String?  @default("El Rancho, Goya, Corrientes")

  // Relación con Animal específico (opcional)
  ganadoId        String?
  ganado          Ganado?  @relation(fields: [ganadoId], references: [id], onDelete: SetNull)

  // Relación con Responsable (Usuario)
  responsableId   String?
  responsable     Usuario? @relation("ResponsableEventos", fields: [responsableId], references: [id], onDelete: SetNull)

  @@index([establecimientoId])
  @@index([fechaProgramada])
  @@index([ganadoId])
  @@map("sanidad_eventos")
}

// 5. Inventario de Insumos y Herramientas
model Insumo {
  id                 String   @id @default(cuid())
  nombre             String
  categoria          String   // "Fármaco", "Nutrición", "Herramientas"
  stockActual        Float
  stockMinimo        Float
  unidad             String   // "Dosis", "Frascos", "Kg", "Bolsas", "Unidades"
  ubicacion          String
  estado             String   @default("OK") // "OK", "Bajo Stock", "Crítico"
  requiereReposicion Boolean  @default(false)
  icono              String?  @default("fa-box-archive")
  fechaRegistro      DateTime @default(now())
  establecimientoId  String?  @default("est-el-rancho")
  establecimiento    String?  @default("El Rancho, Goya, Corrientes")

  @@index([establecimientoId])
  @@index([estado])
  @@map("insumos")
}

// 6. Partes Diarios de Novedades de Campo
model ParteDiario {
  id                String      @id @default(cuid())
  fecha             DateTime    @default(now())
  novedades         String
  animalesRevisados Int         @default(0)
  solicitudInsumos  String?
  estado            EstadoParte @default(PENDIENTE)
  fechaCarga        DateTime    @default(now())
  fechaRevision     DateTime?
  establecimientoId String?     @default("est-el-rancho")
  establecimiento   String?     @default("El Rancho, Goya, Corrientes")

  // Operario que carga el parte (Peón)
  peonId            String
  peon              Usuario     @relation("PeonPartes", fields: [peonId], references: [id], onDelete: Cascade)

  // Supervisor que aprueba el parte (Capataz)
  revisadoPorId     String?
  revisadoPor       Usuario?    @relation("RevisorPartes", fields: [revisadoPorId], references: [id], onDelete: SetNull)

  // Potrero sobre el que se reporta
  potreroId         String?
  potrero           Potrero?    @relation(fields: [potreroId], references: [id], onDelete: SetNull)

  @@index([establecimientoId, fecha])
  @@index([peonId])
  @@index([estado])
  @@map("partes_diarios")
}

// 7. Contactos de la Landing Page
model MensajeContacto {
  id         String   @id @default(cuid())
  nombre     String
  email      String
  telefono   String?
  mensaje    String
  leido      Boolean  @default(false)
  fechaEnvio DateTime @default(now())

  @@map("mensajes_contacto")
}

// 8. Módulo de Chat Compartimentado por Establecimiento y Rol
model MensajeChat {
  id                String   @id @default(cuid())
  contenido         String
  leido             Boolean  @default(false)
  fechaEnvio        DateTime @default(now())
  establecimientoId String

  remitenteId       String
  remitente         Usuario  @relation("MensajesEnviados", fields: [remitenteId], references: [id], onDelete: Cascade)

  destinatarioId    String
  destinatario      Usuario  @relation("MensajesRecibidos", fields: [destinatarioId], references: [id], onDelete: Cascade)

  @@index([establecimientoId, fechaEnvio])
  @@index([remitenteId, destinatarioId])
  @@index([destinatarioId, leido])
  @@map("mensajes_chat")
}

// 9. Contactos Ocultos / Borrados de la Vista Activa de Chat (Soft Delete)
model ChatContactoOculto {
  id                String   @id @default(cuid())
  establecimientoId String
  fechaOcultado     DateTime @default(now())

  usuarioId         String
  usuario           Usuario  @relation("ContactosOcultosUsuario", fields: [usuarioId], references: [id], onDelete: Cascade)

  contactoId        String
  contacto          Usuario  @relation("ContactosOcultosObjetivo", fields: [contactoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, contactoId])
  @@index([usuarioId, establecimientoId])
  @@map("chat_contactos_ocultos")
}