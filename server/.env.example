# Configuración de Servidor Vakera
PORT=4000
NODE_ENV=development

# Base de Datos PostgreSQL (Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/vakera_db?schema=public"

# Clave secreta para firma de tokens JWT (cambiar en producción por un valor aleatorio seguro)
JWT_SECRET=vakera_super_secret_jwt_key_2026

# Orígenes permitidos para CORS (separados por coma, solo necesario en producción)
# CORS_ORIGINS=https://mi-dominio.com,https://www.mi-dominio.com

# Clave de API de Google Maps Platform (con Weather API habilitada) - opcional
# GOOGLE_WEATHER_API_KEY=tu_api_key_aqui
