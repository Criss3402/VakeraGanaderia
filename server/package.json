{
  "name": "ganaderia-los-andes-server",
  "version": "1.0.0",
  "description": "API backend de Vakera (Node.js + Express)",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/unit.test.js \"tests/api/**/*.test.js\"",
    "test:unit": "node --test tests/unit.test.js",
    "test:api": "node --test \"tests/api/**/*.test.js\"",
    "test:int": "node --test \"tests/integration/**/*.int.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage tests/unit.test.js \"tests/api/**/*.test.js\""
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
