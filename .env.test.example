# Variables SOLO para tests (valores ficticios, nunca secretos reales).
# Copiar a .env.test si se necesita personalizar. Los tests no leen .env ni server/.env reales.

# Secreto JWT común a Node y Django en tests (resuelve la deriva R9 del plan)
JWT_SECRET=vakera_test_secret_solo_para_tests_0123456789

# Base efímera de integración (Fase 5): puerto 5434, nunca la de desarrollo (5433)
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5434/vakera_test?schema=public"

# Django: base de tests. sqlite (unitarios) | postgres (integración)
DJANGO_TEST_DB=sqlite

# Sin envío real de correos ni llamadas a APIs externas en tests
SMTP_USER=
SMTP_PASS=
GOOGLE_WEATHER_API_KEY=

