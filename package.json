{
  "name": "vakera-ganaderia",
  "version": "1.0.0",
  "description": "Sistema de Gestión y Trazabilidad Ganadera Vakera",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "server:node": "npm --prefix server run dev",
    "server:py": "python server_py/manage.py runserver 8000",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "py:check": "python server_py/manage.py check",
    "py:test": "python server_py/manage.py test core nutricion reportes"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
